# 1. 进入你的课设项目文件夹（如果还没有就先创建）
mkdir -/Users/evenyoung/nosql-prj
cd cd /Users/evenyoung/nosql-prj

# 2. 创建虚拟环境
python3 -m venv nosqlenv

# 3. 激活环境
source nosqlenv/bin/activate

# 4. 升级 pip（可选但推荐）
pip install --upgrade pip

# 5. 安装你需要的库
pip install pymongo redis neo4j flask

# 6. 验证安装
pip list

//////////////////////////////////每次使用///////////////
# 进入项目目录
cd /Users/evenyoung/nosql-prj

# 激活环境
source nosqlenv/bin/activate

# 开始工作...

# 完成后退出
deactivate